From 3cfc7e1c94cbd974411727434c2151976e396fd5 Mon Sep 17 00:00:00 2001
From: John Cox <jc@kynesim.co.uk>
Date: Tue, 13 Jan 2026 17:04:04 +0000
Subject: [PATCH 16/41] configure: If with-qtconf is given then do not look for
 Qt5

---
 configure.ac | 6 ++++++
 1 file changed, 6 insertions(+)

--- a/configure.ac
+++ b/configure.ac
@@ -3883,6 +3883,12 @@ AC_ARG_ENABLE(qt, [
 have_qt5_x11="no"
 AS_IF([test "${enable_qt}" != "no"], [
   PKG_CHECK_MODULES([QT], [Qt5Core >= 5.5.0 Qt5Widgets Qt5Gui Qt5Svg], [
+      try_qt5="yes"
+  ],[
+      try_qt5="no"
+  ])
+  AS_IF([test -n "${with_qtconf}"], [try_qt5="no"])
+  AS_IF([test "${try_qt5}" != "no"], [
       PKG_CHECK_MODULES([QT5_X11], [Qt5X11Extras], [
           have_qt5_x11="yes"
       ],[
