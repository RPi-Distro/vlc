From eb10875d361418739259998029340b6a38ead6e4 Mon Sep 17 00:00:00 2001
From: John Cox <jc@kynesim.co.uk>
Date: Mon, 8 Sep 2025 13:58:45 +0100
Subject: [PATCH 38/39] avcodec: Add J420 formats as equivalent to YUV420 for
 rpi h/w

---
 modules/codec/avcodec/va.c    | 1 +
 modules/codec/avcodec/video.c | 3 ++-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/modules/codec/avcodec/va.c b/modules/codec/avcodec/va.c
index d58fc829ab..137bdb591a 100644
--- a/modules/codec/avcodec/va.c
+++ b/modules/codec/avcodec/va.c
@@ -60,6 +60,7 @@ vlc_fourcc_t vlc_va_GetChroma(enum PixelFormat hwfmt, enum PixelFormat swfmt)
         case AV_PIX_FMT_DRM_PRIME:
             switch (swfmt)
             {
+                case AV_PIX_FMT_YUVJ420P:
                 case AV_PIX_FMT_YUV420P:
                     return VLC_CODEC_DRM_PRIME_I420;
                 case AV_PIX_FMT_NV12:
diff --git a/modules/codec/avcodec/video.c b/modules/codec/avcodec/video.c
index b9b13720b8..9565294039 100644
--- a/modules/codec/avcodec/video.c
+++ b/modules/codec/avcodec/video.c
@@ -1981,7 +1981,8 @@ no_reuse:
         {
             if (swfmt == AV_PIX_FMT_P010)
                 defsw = AV_PIX_FMT_RPI4_10;
-            if (swfmt == AV_PIX_FMT_YUV420P)
+            if (swfmt == AV_PIX_FMT_YUV420P ||
+                swfmt == AV_PIX_FMT_YUVJ420P)
                 defsw = AV_PIX_FMT_RPI4_8;
         }
 #endif
