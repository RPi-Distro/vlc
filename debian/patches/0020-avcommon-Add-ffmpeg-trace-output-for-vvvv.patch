From 44c5ecedc4044d05178e3b8077ebdff97b8131a0 Mon Sep 17 00:00:00 2001
From: John Cox <jc@kynesim.co.uk>
Date: Tue, 11 Jun 2024 17:10:30 +0100
Subject: [PATCH 20/39] avcommon: Add ffmpeg trace output for -vvvv

---
 modules/codec/avcodec/avcommon.h | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/modules/codec/avcodec/avcommon.h b/modules/codec/avcodec/avcommon.h
index 10ad13dc5f..efef92721e 100644
--- a/modules/codec/avcodec/avcommon.h
+++ b/modules/codec/avcodec/avcommon.h
@@ -84,7 +84,10 @@ static inline void vlc_init_avutil(vlc_object_t *obj)
             break;
         case VLC_MSG_DBG+1:
             level = AV_LOG_DEBUG;
+            break;
         default:
+            if (verbose + VLC_MSG_ERR >= VLC_MSG_DBG+2)
+                level = AV_LOG_TRACE;
             break;
         }
     }
