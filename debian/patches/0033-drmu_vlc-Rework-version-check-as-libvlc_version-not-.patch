 #include <errno.h>
 
-#include <vlc/libvlc_version.h>
 #include <libavutil/buffer.h>
 #include <libavutil/hwcontext_drm.h>
 
@@ -26,7 +25,7 @@ pic_fb_delete_cb(void * v)
     fb_aux_pic_t * const aux = v;
     picture_context_t * const ctx = aux->pic_ctx;
 
-#if LIBVLC_VERSION_MAJOR >= 4
+#if HAS_VLC4
     vlc_video_context *vctx = ctx->vctx;
     ctx->destroy(ctx);
     if (vctx)
diff --git a/modules/video_output/drmu/drmu_vlc.h b/modules/video_output/drmu/drmu_vlc.h
index 5c19141930..1a7edeed1c 100644
--- a/modules/video_output/drmu/drmu_vlc.h
+++ b/modules/video_output/drmu/drmu_vlc.h
@@ -1,11 +1,16 @@
 #ifndef _DRMU_DRMU_VLC_H
 #define _DRMU_DRMU_VLC_H
 
-#include "config.h"
-
 #ifndef HAS_VLC4
-#define HAS_VLC4     0
+// This is expected to be VLCs build config.h
+// If using this outside of a VLC build maybe libvlc_version.h
+#include "config.h"
+#ifndef PACKAGE_VERSION_MAJOR
+#error Expected to have PACKAGE_VERSION_MAJOR defined by config.h
 #endif
+#define HAS_VLC4     ((PACKAGE_VERSION_MAJOR) > 3)
+#endif
+
 #ifndef HAS_ZC_CMA
 #define HAS_ZC_CMA   0
 #endif
diff --git a/modules/video_output/drmu/drmu_vlc_fmts.c b/modules/video_output/drmu/drmu_vlc_fmts.c
index f10a5d9366..21bd47c84b 100644
